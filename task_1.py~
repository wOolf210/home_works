class MainClass:
    def __init__(self, text=""):
        self._text = text

    def set_text(self, text=None):
        if text is not None:
            self._text = text
        else:
            self._text = "Значение не задано"

    def get_text(self):
        return self._text

    def display_info(self):
        return f"Текст: {self._text}"


class SubClass(MainClass):
    def __init__(self, text, number):
        super().__init__(text)
        self._number = number

    def set_number(self, number):
        self._number = number

    def get_number(self):
        return self._number

    def display_info(self):
        return f"Текст: {self._text}, Число: {self._number}"


if __name__ == "__main__":
    # Создание объекта главного класса
    main_object = MainClass("Привет, мир!")
    print(main_object.display_info())  # Выводит только текст

    # Изменение текста через метод
    main_object.set_text("Новый текст")
    print(main_object.display_info())  # Выводит обновленный текст

    # Создание объекта класса потомка
    sub_object = SubClass("Текст потомка", 42)
    print(sub_object.display_info())  # Выводит текст и число

    # Изменение числа в классе потомке
    sub_object.set_number(100)
    print(sub_object.display_info())  # Выводит обновленный текст и число
